SECRET_KEY=change-this-to-a-secure-random-secret-key-32-bytes
FERNET_KEY=change-this-to-a-valid-fernet-key-base64-encoded
# AI Provider: gemini or gemma or anthropic
LLM_PROVIDER=gemini
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Supported models: gemini-1.5-flash (recommended free default), gemini-2.0-flash, gemma-4-26b-a4b-it
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./aaina.db
